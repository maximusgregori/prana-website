---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import FindUs from '../components/FindUs.astro';
import { withBase } from '../lib/paths';

const title = 'Home | Prana Wellness Club';
const description =
  'A boutique Austin wellness studio for Reformer Pilates, Mat Pilates, and yoga, with sauna, steam, and cold plunge recovery. Move with intention. Rest with purpose.';

const site = Astro.site ?? new URL('https://constanceit.github.io/');
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL(withBase('/images/og/home.jpg'), site).toString();

const heroPoster = withBase('/images/home/hero-poster.jpg');
const heroVideoMp4 = withBase('/videos/home/hero-bg.mp4');
const heroVideoMov = withBase('/videos/home/hero-bg.mov');
const spaceVideoMp4 = withBase('/videos/home/space-card.mp4');
const spacePoster = withBase('/images/home/space-poster.jpg');
const membershipImage = withBase('/images/home/membership.jpg');
const storyImage = withBase('/images/home/story.jpg');
const classHeatedVinyasaImg = withBase('/images/home/classes/heated-vinyasa.jpg');
const classPilatesReformerImg = withBase('/images/home/classes/pilates-reformer.jpg');
const classYinImg = withBase('/images/home/classes/yin.jpg');
const bookHref = withBase('/book');
const classesHref = withBase('/classes');
const studioHref = withBase('/studio');
const membershipsHref = withBase('/memberships');
/* Map and contact variables moved to FindUs.astro component */

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HealthClub',
  name: 'Prana Wellness Club',
  url: canonical,
  image: ogImage,
  email: 'hello@pranawellness.love',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1621 E 7th St',
    addressLocality: 'Austin',
    addressRegion: 'TX',
    postalCode: '78702',
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 30.2631319,
    longitude: -97.7246735,
  },
  // TODO: add openingHoursSpecification once studio hours are supplied.
};

const tiles = [
  {
    number: '01 · PRACTICE',
    label: 'Yoga',
    image: withBase('/images/home/yoga-card.jpg'),
    alt: 'Prana yoga studio during a class',
    description:
      'Heated and unheated vinyasa, hatha, yin, and slow flow. Morning sessions, lunch breaks, and Wine Down Wednesdays. Open to every level.',
    link: { href: classesHref, label: 'See the schedule' },
  },
  {
    number: '02 · STRENGTHEN',
    label: 'Pilates',
    image: withBase('/images/home/pilates-card.jpg'),
    alt: 'A Pilates reformer class at Prana',
    description:
      'Reformer and mat classes built around posture, core, and long muscle tone. Small group sizes so instructors can actually adjust your form.',
    link: { href: classesHref, label: 'See the schedule' },
  },
  {
    number: '03 · RESTORE',
    label: 'The Space',
    image: withBase('/images/home/space-card.jpg'),
    alt: 'The wooden reformers and recovery space at Prana',
    description:
      'Sauna, steam, cold plunge, and a quiet lounge to come down from the heat. Included with membership, open to class guests.',
    link: { href: studioHref, label: 'Tour the studio' },
  },
];

const featuredClasses = [
  {
    category: 'Vinyasa',
    title: 'Heated Vinyasa',
    description:
      'A flowing, breath-led practice in a warm room. Builds strength, sweat, and stillness in equal measure.',
    meta: ['60 MIN', 'HEATED 95°F'],
    href: withBase('/classes/heated-vinyasa'),
    image: classHeatedVinyasaImg,
    alt: 'A heated vinyasa class at Prana',
  },
  {
    category: 'Pilates',
    title: 'Pilates Reformer',
    description:
      'Small-group Reformer work focused on posture, control, and long muscle tone. Great for first-timers and regulars.',
    meta: ['50 MIN', 'NEUTRAL'],
    href: withBase('/classes/pilates-reformer'),
    image: classPilatesReformerImg,
    alt: 'Wooden reformers at Prana',
  },
  {
    category: 'Yin',
    title: 'Yin',
    description:
      'Long holds, deep breath, and quiet mats. A reset for anyone living in their shoulders or their phone.',
    meta: ['75 MIN', 'WARM 80°F'],
    href: withBase('/classes/yin'),
    image: classYinImg,
    alt: 'A student in a yin stretch on the mat',
  },
  {
    category: 'Strength',
    title: 'Strength & Mobility Flow',
    description:
      'Loaded strength work woven into a mobility practice. For when you want yoga to hit like a training session.',
    meta: ['55 MIN', 'NEUTRAL'],
    href: withBase('/classes/strength-mobility-flow'),
    image: null,
    alt: null,
  },
];
---

<BaseLayout title={title} description={description} ogImage="/images/og/home.jpg" canonical={canonical}>
  <script type="application/ld+json" slot="jsonld" set:html={JSON.stringify(jsonLd)} />

  <!-- SECTION 1 — HERO -->
  <section class="hero" aria-labelledby="hero-headline" data-header-watch="hero">
    <div class="hero__media" style={`--hero-poster: url('${heroPoster}');`}>
      <video
        class="hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={heroPoster}
        aria-hidden="true"
      >
        <source src={heroVideoMp4} type="video/mp4" />
        <source src={heroVideoMov} type="video/quicktime" />
      </video>
      <div class="hero__gradient" aria-hidden="true"></div>
    </div>

    <div class="hero__content">
      <span class="eyebrow hero__eyebrow">Austin · Est. 2024</span>
      <h1 id="hero-headline" class="hero__headline">
        Move with intention.<br />Rest with purpose.
      </h1>
      <p class="hero__support">A boutique Austin studio for Pilates, yoga, and recovery.</p>
      <div class="hero__actions">
        <a href={bookHref} class="btn btn-primary hero__cta">Book a Class</a>
        <a href={membershipsHref} class="btn btn-ghost btn-ghost--light hero__cta">Memberships</a>
      </div>
    </div>
  </section>

  <!-- SECTION 2 — WELCOME -->
  <section class="welcome">
    <div class="welcome__inner">
      <span class="eyebrow welcome__eyebrow">Welcome to Prana</span>
      <h2 class="welcome__headline">A studio built around how you actually want to feel.</h2>
      <div class="welcome__prose">
        <p>
          Prana is a boutique wellness club in South Austin. Reformer and Mat Pilates, vinyasa,
          hatha, yin, recovery. All of it under one roof, all of it taught by people who live in
          this neighborhood and want you to keep coming back.
        </p>
        <p>
          We built the studio the way we wished one existed when we were tired of fluorescent gyms
          and chain yoga rooms. Warm wood, real plants, natural light, equipment that actually
          holds up, teachers who learn your name. Come once and you'll get it.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 3 — WHAT WE OFFER -->
  <section class="offer">
    <div class="container">
      <div class="offer__header">
        <span class="eyebrow">What we offer</span>
        <h2 class="offer__headline">Three ways to show up.</h2>
      </div>

      <ul class="offer__grid">
        {tiles.map((tile) => (
          <li class="tile">
            <a href={tile.link.href} class="tile__link">
              <div class="tile__image-wrap">
                <img
                  src={tile.image}
                  alt={tile.alt}
                  width="720"
                  height="864"
                  loading="lazy"
                  class="tile__image"
                />
              </div>
              <div class="tile__body">
                <span class="eyebrow tile__eyebrow">{tile.number}</span>
                <h3 class="tile__label">{tile.label}</h3>
                <p class="tile__description">{tile.description}</p>
                <span class="link-arrow">{tile.link.label} <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SECTION 4 — OUR STORY TEASER -->
  <section class="story">
    <div class="story__grid">
      <div class="story__image">
        <img
          src={storyImage}
          alt="Inside the Prana studio, warm wood, natural light, and plants"
          width="840"
          height="1050"
          loading="lazy"
        />
      </div>

      <div class="story__copy">
        <span class="eyebrow">Our story</span>
        <h2 class="story__headline">A place to come back to.</h2>

        <p class="story__body">
          Prana started as a small idea between friends who were tired of practicing in rooms
          that felt nothing like the practice. Today it's a full studio in South Austin where
          the reformers are wooden, the plants are real, and the people at the front desk
          actually remember your name.
        </p>

        <blockquote class="story__quote">
          "We wanted a room that felt like it exhaled when you walked in."
        </blockquote>

        <p class="story__body">
          We think of ourselves less like a gym and more like a third place. Somewhere between
          your home and your work where the only agenda is to feel better than you did when you
          walked in.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 5 — FEATURED CLASSES -->
  <section class="featured">
    <div class="container">
      <div class="featured__header">
        <span class="eyebrow">On the schedule</span>
        <h2 class="featured__headline">Classes worth showing up for.</h2>
      </div>

      <ul class="featured__stack">
        {featuredClasses.map((c) => (
          <li class="class-card">
            <div class="class-card__image">
              {c.image ? (
                <img
                  src={c.image}
                  alt={c.alt}
                  width="900"
                  height="600"
                  loading="lazy"
                />
              ) : (
                <PlaceholderImage
                  ratio="3 / 2"
                  label={`Class photo, ${c.title}`}
                  alt={`Placeholder image for the ${c.title} class`}
                />
              )}
            </div>
            <div class="class-card__body">
              <span class="eyebrow class-card__eyebrow">{c.category}</span>
              <h3 class="class-card__title">{c.title}</h3>
              <p class="class-card__description">{c.description}</p>
              <span class="class-card__meta">{c.meta[0]} · {c.meta[1]}</span>
              <a href={c.href} class="link-arrow">View class <span aria-hidden="true">→</span></a>
            </div>
          </li>
        ))}
      </ul>

      <div class="featured__cta">
        <a href={classesHref} class="btn btn-primary">See all classes</a>
      </div>
    </div>
  </section>

  <!-- SECTION 6 — THE SPACE TEASER -->
  <section class="space" aria-labelledby="space-headline">
    <div class="space__media">
      <video
        class="space__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={spacePoster}
        aria-hidden="true"
      >
        <source src={spaceVideoMp4} type="video/mp4" />
      </video>
      <div class="space__gradient" aria-hidden="true"></div>
    </div>

    <div class="space__content container">
      <span class="eyebrow space__eyebrow">The Space</span>
      <h2 id="space-headline" class="space__headline">Wind down your way.</h2>
      <p class="space__body">
        An infrared sauna, a cold plunge, a steam room, and a lounge with the best elixir bar in
        town. Our recovery space is included with every membership.
      </p>
      <a href={studioHref} class="btn btn-ghost btn-ghost--light space__link">See the space →</a>
    </div>
  </section>

  <!-- SECTION 7 — MEMBERSHIP INVITATION -->
  <section class="membership">
    <div class="membership__grid">
      <div class="membership__image-wrap">
        <img
          src={membershipImage}
          alt="A quiet corner of the Prana studio"
          width="960"
          height="1200"
          loading="lazy"
          class="membership__image"
        />
      </div>

      <div class="membership__copy">
        <span class="eyebrow">Membership</span>
        <h2 class="membership__headline">One membership. The whole studio.</h2>
        <p class="membership__body">
          Unlimited classes across yoga, Pilates, and Reformer. Full access to the sauna, steam
          room, and cold plunge. First dibs on events and workshops. Cancel any time.
        </p>
        <span class="eyebrow membership__founding">Now accepting founding members</span>
        <div class="membership__actions">
          <a href={membershipsHref} class="btn btn-primary">See membership options</a>
          <a href={bookHref} class="btn btn-ghost">Or book a single class →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 8 — FIND US -->
  <FindUs bg="warm-white" />
</BaseLayout>

<style>
  /* ==================== SECTION 1 — HERO ==================== */
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--color-deep-brown);
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__gradient {
    position: absolute;
    inset: 0;
    background: rgba(58, 42, 34, 0.55);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
    .hero__media {
      background-image: var(--hero-poster);
      background-size: cover;
      background-position: center;
    }
  }

  .hero__content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: var(--content-max);
    padding-inline: var(--space-2xl);
  }

  .hero__eyebrow {
    color: var(--color-warm-white);
    margin-bottom: var(--space-xs);
    display: inline-block;
  }

  .hero__headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--size-h1);
    line-height: var(--line-tight);
    color: var(--color-warm-white);
    margin-bottom: var(--space-lg);
    text-wrap: balance;
  }

  .hero__support {
    font-family: var(--font-body);
    font-size: var(--size-body-lg);
    color: var(--color-warm-white);
    max-width: 48ch;
    line-height: 1.5;
    margin-bottom: var(--space-xl);
    text-align: center;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    width: 100%;
    max-width: 360px;
  }

  @media (min-width: 640px) {
    .hero__actions {
      flex-direction: row;
      gap: var(--space-md);
      max-width: none;
      width: auto;
    }
  }

  @media (max-width: 639px) {
    .hero__cta {
      width: 100%;
    }
  }

  /* ==================== SECTION 2 — WELCOME ==================== */
  .welcome {
    background-color: var(--color-cream);
    padding: var(--space-4xl) var(--space-lg);
  }

  @media (min-width: 1024px) {
    .welcome {
      padding: var(--space-6xl) var(--space-2xl);
    }
  }

  .welcome__inner {
    max-width: var(--content-narrow);
    margin-inline: auto;
    text-align: center;
  }

  .welcome__eyebrow {
    color: var(--color-terracotta);
    display: inline-block;
    margin-bottom: var(--space-lg);
  }

  .welcome__headline {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--size-h2);
    line-height: var(--line-tight);
    color: var(--color-deep-brown);
    max-width: 20ch;
    margin: 0 auto var(--space-2xl);
    text-wrap: balance;
  }

  .welcome__prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    text-align: center;
    max-width: var(--content-narrow);
    margin-inline: auto;
  }

  .welcome__prose p {
    font-size: var(--size-body);
    line-height: var(--line-body);
    color: var(--color-espresso);
  }

  /* ==================== SECTION 3 — OFFER ==================== */
  .offer {
    background-color: var(--color-cream);
    padding: var(--space-4xl) 0;
    border-top: 1px solid var(--color-hairline);
  }

  @media (min-width: 1024px) {
    .offer { padding: var(--space-5xl) 0; }
  }

  .offer__header {
    margin-bottom: var(--space-3xl);
    max-width: 36ch;
  }

  .offer__header .eyebrow {
    color: var(--color-terracotta);
    margin-bottom: var(--space-md);
  }

  .offer__headline {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--size-h2);
    line-height: var(--line-tight);
    color: var(--color-deep-brown);
  }

  .offer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 640px) {
    .offer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .offer__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-xl);
    }
  }

  .tile {
    display: block;
  }

  .tile__link {
    display: block;
    color: inherit;
  }

  .tile__image-wrap {
    aspect-ratio: 5 / 6;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background-color: var(--color-placeholder);
    margin-bottom: var(--space-lg);
  }

  .tile__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.97);
    transition: filter var(--dur-slow) var(--ease-out), transform var(--dur-slow) var(--ease-out);
  }

  .tile__link:hover .tile__image,
  .tile__link:focus-visible .tile__image {
    filter: brightness(1.02);
    transform: scale(1.01);
  }

  .tile__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .tile__eyebrow {
    color: var(--color-terracotta);
    margin-bottom: var(--space-xs);
  }

  .tile__label {
    font-family: var(--font-display);
    font-size: var(--size-h3);
    font-weight: 500;
    color: var(--color-deep-brown);
    line-height: var(--line-snug);
    transition: color var(--dur-med) var(--ease-out);
  }

  .tile__link:hover .tile__label,
  .tile__link:focus-visible .tile__label {
    color: var(--color-terracotta);
  }

  .tile__description {
    font-size: var(--size-body);
    line-height: var(--line-body);
    color: var(--color-espresso);
    max-width: 42ch;
  }

  /* ==================== SECTION 4 — STORY ==================== */
  .story {
    background-color: var(--color-warm-white);
    padding: var(--space-4xl) var(--space-lg);
  }

  @media (min-width: 1024px) {
    .story { padding: var(--space-6xl) var(--space-2xl); }
  }

  .story__grid {
    max-width: var(--content-max);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 1024px) {
    .story__grid {
      grid-template-columns: repeat(12, 1fr);
      gap: var(--space-2xl);
      align-items: start;
    }
  }

  .story__image {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background-color: var(--color-placeholder);
  }

  .story__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 1024px) {
    .story__image {
      grid-column: 1 / span 4;
      max-width: 420px;
      margin-top: var(--space-3xl);
    }
  }

  .story__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 600px;
  }

  @media (min-width: 1024px) {
    .story__copy {
      grid-column: 6 / span 6;
    }
  }

  .story__copy .eyebrow {
    color: var(--color-terracotta);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .story__headline {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--size-h2);
    line-height: var(--line-tight);
    color: var(--color-deep-brown);
    max-width: 15ch;
  }

  .story__body {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--size-body);
    line-height: var(--line-body);
    color: var(--color-espresso);
    max-width: 56ch;
  }

  .story__quote {
    font-family: var(--font-display);
    font-size: var(--size-h3);
    font-weight: 400;
    font-style: italic;
    line-height: var(--line-snug);
    color: var(--color-terracotta);
    max-width: 22ch;
    margin-block: var(--space-xl);
  }

  /* ==================== SECTION 5 — FEATURED CLASSES ==================== */
  .featured {
    background-color: var(--color-cream);
    padding: var(--space-4xl) 0;
  }

  @media (min-width: 1024px) {
    .featured { padding: var(--space-5xl) 0; }
  }

  .featured__header {
    margin-bottom: var(--space-3xl);
    max-width: 36ch;
  }

  .featured__header .eyebrow {
    color: var(--color-terracotta);
    margin-bottom: var(--space-md);
  }

  .featured__headline {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--size-h2);
    line-height: var(--line-tight);
    color: var(--color-deep-brown);
  }

  .featured__stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .class-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .class-card {
      flex-direction: row;
      gap: var(--space-2xl);
    }
  }

  .class-card__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--color-placeholder);
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .class-card__image {
      width: 35%;
      aspect-ratio: 3 / 2;
    }
  }

  @media (min-width: 1024px) {
    .class-card__image {
      width: 40%;
    }
  }

  .class-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .class-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    justify-content: center;
  }

  @media (min-width: 768px) {
    .class-card__body {
      flex: 1;
    }
  }

  .class-card__eyebrow {
    color: var(--color-terracotta);
  }

  .class-card__title {
    font-family: var(--font-display);
    font-size: var(--size-h3);
    font-weight: 500;
    color: var(--color-deep-brown);
    line-height: var(--line-snug);
    margin-top: var(--space-xs);
  }

