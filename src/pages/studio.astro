---
import BaseLayout from '../layouts/BaseLayout.astro';
import FindUs from '../components/FindUs.astro';
import { withBase } from '../lib/paths';

const title = 'The Studio | Prana Wellness Club';
const description =
  'Step inside Prana Wellness Club in East Austin. Wooden reformers, heated yoga floors, infrared sauna, cold plunge, and a lounge worth lingering in.';

const site = Astro.site ?? new URL('https://constanceit.github.io/');
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL(withBase('/images/og/studio.jpg'), site).toString();

const heroImage = withBase('/images/studio/hero.jpg');
const membershipImage = withBase('/images/studio/membership.jpg');

const classesHref = withBase('/classes');
const membershipsHref = withBase('/memberships');
const bookHref = withBase('/book');

const instagramImages = [
  { src: withBase('/images/studio/instagram/01.jpg'), alt: 'Rows of wooden Pilates reformers at Prana', width: 600, height: 800 },
  { src: withBase('/images/studio/instagram/02.jpg'), alt: 'Members chatting at the Prana lounge after class', width: 600, height: 800 },
  { src: withBase('/images/studio/instagram/03.jpg'), alt: 'Warm lighting and textures inside Prana', width: 600, height: 800 },
  { src: withBase('/images/studio/instagram/04.jpg'), alt: 'A yoga class in session at Prana', width: 600, height: 800 },
  { src: withBase('/images/studio/instagram/05.jpg'), alt: 'Two members hugging after class', width: 600, height: 800 },
  { src: withBase('/images/studio/instagram/06.jpg'), alt: 'Students settling in before yoga class', width: 600, height: 800 },
  { src: withBase('/images/studio/instagram/07.jpg'), alt: 'Overhead view of a yoga stretch', width: 600, height: 800 },
  { src: withBase('/images/studio/instagram/08.jpg'), alt: 'The Prana Wellness Club studio interior', width: 600, height: 800 },
  { src: withBase('/images/studio/instagram/09.jpg'), alt: 'Staff passing out towels before class', width: 600, height: 800 },
];

const amenities = [
  {
    eyebrow: 'YOGA',
    title: 'Warm floors. Good light. A room that breathes.',
    body: 'The yoga studio seats eighteen and runs warm year-round with radiant heated flooring. Morning light comes in through east-facing windows. The ceiling is high enough to feel open without feeling cavernous. We run heated vinyasa, hatha, yin, restorative, and a Friday night flow that people tend to stay for long after the last savasana.',
    link: { label: 'See the class schedule', href: classesHref },
    image: {
      src: withBase('/images/studio/amenities/yoga-studio.jpg'),
      alt: 'Members stretching before a heated yoga class at Prana',
      width: 1200,
      height: 900,
    },
  },
  {
    eyebrow: 'PILATES',
    title: 'Wooden reformers. Small groups. Real adjustments.',
    body: 'Twelve custom-built wooden reformers from a small shop in Oregon. They\'re beautiful to look at and smooth to work on. Classes cap at twelve so your instructor can actually see you, correct your form, and remember where you left off last time. We run Reformer, Reformer Sculpt, and a mat class for people who like their Pilates stripped down.',
    link: { label: 'See the class schedule', href: classesHref },
    image: {
      src: withBase('/images/studio/amenities/reformer-studio.jpg'),
      alt: 'Custom wooden Pilates reformers at Prana Wellness Club',
      width: 1200,
      height: 900,
    },
  },
  {
    eyebrow: 'RECOVERY',
    title: 'Cedar walls and dry heat.',
    body: 'A co-ed infrared sauna built into the recovery wing. Cedar-lined, seats six, runs between 130 and 150 degrees. Most members use it after class as a cool-down, but some come just for the sauna. It\'s a slower, deeper heat than traditional steam, and it\'s included with every membership.',
    link: { label: 'Learn about memberships', href: membershipsHref },
    image: {
      src: withBase('/images/studio/amenities/sauna.jpg'),
      alt: 'Cedar-lined infrared sauna at Prana with stone heater',
      width: 765,
      height: 573,
    },
  },
  {
    eyebrow: 'RECOVERY',
    title: 'Forty degrees. Two minutes. You\'ll feel it all day.',
    body: 'The cold plunge sits across from the sauna for easy contrast therapy. Water stays between 39 and 45 degrees. Most people start with 60 seconds and work up from there. It\'s the part of the studio people are most nervous about and most glad they tried.',
    link: { label: 'Learn about memberships', href: membershipsHref },
    image: {
      src: withBase('/images/studio/amenities/cold-plunge.jpg'),
      alt: 'Cold plunge pool at Prana Wellness Club',
      width: 765,
      height: 573,
    },
  },
  {
    eyebrow: 'AMENITIES',
    title: 'Showers, products, towels. Show up with just your clothes.',
    body: 'Full locker rooms with walk-in showers, spa-grade shampoo and body wash, fresh towels, and secure day lockers. We keep hair dryers, deodorant, and a few other things stocked so you can go straight from class to wherever you\'re headed next.',
    link: null,
    image: {
      src: withBase('/images/studio/amenities/locker-rooms.jpg'),
      alt: 'Locker room with showers, towels, and moss wall at Prana',
      width: 765,
      height: 573,
    },
  },
  {
    eyebrow: 'COMMUNITY',
    title: 'Stay a while.',
    body: 'The lounge is the part of the studio that surprises people. A handful of tables, a counter with stools, and an elixir bar serving matcha, smoothies, adaptogens, and a rotating seasonal menu. It\'s where people end up after class, talking longer than they planned. We built it because the best studios we\'ve been to always had a reason to linger.',
    link: null,
    image: {
      src: withBase('/images/studio/amenities/lounge.jpg'),
      alt: 'Members chatting at the lounge and elixir bar after class',
      width: 1200,
      height: 900,
    },
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HealthClub',
  name: 'Prana Wellness Club',
  url: canonical,
  image: ogImage,
  email: 'hello@pranawellness.love',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1621 E 7th St',
    addressLocality: 'Austin',
    addressRegion: 'TX',
    postalCode: '78702',
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 30.2631319,
    longitude: -97.7246735,
  },
  // TODO: add openingHoursSpecification once studio hours are supplied.
};
---

<BaseLayout title={title} description={description} ogImage="/images/og/studio.jpg" canonical={canonical}>
  <script type="application/ld+json" slot="jsonld" set:html={JSON.stringify(jsonLd)} />

  <!-- SECTION 1 — HERO (cinematic letterbox banner) -->
  <section class="studio-hero" aria-labelledby="studio-headline" data-header-watch="hero">
    <div class="studio-hero__media">
      <img
        src={heroImage}
        alt="Inside the Prana Wellness Club reformer studio"
        width="765"
        height="430"
        fetchpriority="high"
        class="studio-hero__image"
      />
      <div class="studio-hero__gradient" aria-hidden="true"></div>
    </div>

    <div class="studio-hero__content">
      <span class="eyebrow studio-hero__eyebrow">East Austin · Est. 2024</span>
      <h1 id="studio-headline" class="studio-hero__headline">Step inside.</h1>
      <p class="studio-hero__support">A studio built to feel as good as the practice.</p>
      <a href={bookHref} class="btn btn-primary studio-hero__cta">Book a Class</a>
    </div>
  </section>

  <!-- SECTION 2 — OUR STORY (animated SVG timeline) -->
  <section class="timeline" aria-labelledby="timeline-headline">
    <div class="container">
      <div class="timeline__header">
        <span class="eyebrow">Our story</span>
        <h2 id="timeline-headline" class="timeline__headline">How we got here.</h2>
      </div>
    </div>

    <div class="timeline__body">
      <svg class="timeline__svg" aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 200 1000">
        <path
          class="timeline__path"
          d="M100,0 C40,80 160,160 100,250 C40,340 160,420 100,500 C40,580 160,660 100,750 C40,840 160,920 100,1000"
          fill="none"
          stroke="var(--color-terracotta)"
          stroke-opacity="0.35"
          stroke-width="2"
        />
      </svg>

      <!-- Dots positioned by JS to align with milestones -->
      <div class="timeline__dot" aria-hidden="true"><span class="timeline__dot-outer"></span><span class="timeline__dot-inner"></span></div>
      <div class="timeline__dot" aria-hidden="true"><span class="timeline__dot-outer"></span><span class="timeline__dot-inner"></span></div>
      <div class="timeline__dot" aria-hidden="true"><span class="timeline__dot-outer"></span><span class="timeline__dot-inner"></span></div>

      <div class="timeline__milestones">
        <!-- Milestone 1 — The Idea -->
        <div class="timeline__milestone timeline__milestone--left">
          <span class="eyebrow timeline__year">2023</span>
          <h3 class="timeline__milestone-title">The Idea</h3>
          <p class="timeline__milestone-body">It started with a complaint that turned into a question. A handful of friends, all driving thirty minutes across Austin to studios that never quite felt right. Too cold, too corporate, too much like a gym wearing yoga pants. Someone finally said, "What if we just built our own?" That was the conversation that wouldn't go away.</p>
        </div>

        <!-- Milestone 2 — The Build -->
        <div class="timeline__milestone timeline__milestone--right">
          <span class="eyebrow timeline__year">2024</span>
          <h3 class="timeline__milestone-title">The Build</h3>
          <p class="timeline__milestone-body">A 4,000-square-foot shell on East 7th. The floors went in heated because cold feet ruin a good savasana. The reformers came from a small woodworker in Oregon who builds them one at a time. An infrared sauna, because dry heat was non-negotiable. A cold plunge, because one of us wouldn't stop talking about it. The arched alcoves in the walls weren't in the original plans. We added them because the space needed somewhere for the eye to rest.</p>
        </div>

        <!-- Milestone 3 — Opening Day -->
        <div class="timeline__milestone timeline__milestone--left">
          <span class="eyebrow timeline__year">2024</span>
          <h3 class="timeline__milestone-title">Opening Day</h3>
          <p class="timeline__milestone-body">Prana opened with six classes a week and a handful of members who were mostly just friends being supportive. Within a month the waitlist was real. Today we run more than twenty classes a week across yoga, Pilates, and strength, and the Friday night flow has a habit of turning into something closer to a dinner party. The original idea hasn't changed: a studio should feel like a place you want to be in, not just a room you sweat in.</p>
        </div>
      </div>
    </div>

    <blockquote class="timeline__quote">
      "We didn't set out to open a studio. We set out to build the room we kept wishing existed."
    </blockquote>
  </section>

  <!-- SECTION 3 — INSTAGRAM GRID -->
  <section class="insta" aria-labelledby="insta-headline">
    <div class="container">
      <div class="insta__header">
        <span class="eyebrow">@pranawellness</span>
        <h2 id="insta-headline" class="insta__headline">Follow along.</h2>
      </div>

      <div class="insta__grid">
        {instagramImages.map((img) => (
          <div class="insta__cell">
            <img
              src={img.src}
              alt={img.alt}
              width={img.width}
              height={img.height}
              loading="lazy"
              class="insta__img"
            />
          </div>
        ))}
      </div>

      <div class="insta__follow">
        <a
          href="https://www.instagram.com/pranawellnessclub/"
          target="_blank"
          rel="noreferrer noopener"
          class="link-arrow"
        >
          Follow us on Instagram <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 4 — AMENITIES -->
  <section class="amenities" aria-labelledby="amenities-headline">
    <div class="container">
      <div class="amenities__header">
        <span class="eyebrow">Amenities</span>
        <h2 id="amenities-headline" class="amenities__headline">Everything under one roof.</h2>
        <p class="amenities__intro">Prana isn't just a place to take a class. It's a full studio with recovery, community, and a reason to stay longer than you planned.</p>
      </div>

      <div class="amenities__list">
        {amenities.map((item, i) => (
          <div class={`amenity ${i % 2 !== 0 ? 'amenity--reversed' : ''}`}>
            <div class="amenity__image-wrap">
              <img
                src={item.image.src}
                alt={item.image.alt}
                width={item.image.width}
                height={item.image.height}
                loading="lazy"
                class="amenity__image"
              />
            </div>
            <div class="amenity__copy">
              <span class="eyebrow amenity__eyebrow">{item.eyebrow}</span>
              <h3 class="amenity__title">{item.title}</h3>
              <p class="amenity__body">{item.body}</p>
              {item.link && (
                <a href={item.link.href} class="link-arrow">
                  {item.link.label} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 5 — MEMBERSHIP CTA -->
  <section class="studio-membership" aria-labelledby="membership-headline">
    <div class="studio-membership__grid">
      <div class="studio-membership__copy">
        <span class="eyebrow">Membership</span>
        <h2 id="membership-headline" class="studio-membership__headline">One membership. The whole space.</h2>
        <p class="studio-membership__body">
          Unlimited classes, full access to the sauna, cold plunge, and lounge, and first priority on workshops and events. No contracts, no long commitments. Cancel any time.
        </p>
        <span class="eyebrow studio-membership__founding">Now accepting founding members</span>
        <div class="studio-membership__actions">
          <a href={membershipsHref} class="btn btn-primary">See membership options</a>
          <a href={bookHref} class="btn btn-ghost">Or book a single class →</a>
        </div>
      </div>

      <div class="studio-membership__image-wrap">
        <img
          src={membershipImage}
          alt="The Prana lounge with slatted wood ceiling and warm lighting"
          width="765"
          height="956"
          loading="lazy"
          class="studio-membership__image"
        />
      </div>
    </div>
  </section>

  <!-- SECTION 6 — FIND US -->
  <FindUs bg="warm-white" />
</BaseLayout>

<!-- Tiny inline script: set --path-length for scroll-draw + Safari fallback -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const path = document.querySelector('.timeline__path') as SVGPathElement | null;
    if (!path) return;

    const length = path.getTotalLength();
    path.style.setProperty('--path-length', String(length));

    // Position dot nodes to align with actual milestone elements
    const body = document.querySelector('.timeline__body') as HTMLElement | null;
    const milestones = document.querySelectorAll('.timeline__milestone');
    const dots = document.querySelectorAll('.timeline__dot') as NodeListOf<HTMLElement>;
    const svg = document.querySelector('.timeline__svg') as SVGElement | null;

    function positionDots() {
      if (!body || !svg) return;
      const bodyRect = body.getBoundingClientRect();
      const svgRect = svg.getBoundingClientRect();
      const svgCenterX = svgRect.left + svgRect.width / 2 - bodyRect.left;

      milestones.forEach((ms, i) => {
        if (!dots[i]) return;
        const msRect = ms.getBoundingClientRect();
        const dotTop = msRect.top - bodyRect.top;
        dots[i].style.left = `${svgCenterX - 8}px`;
        dots[i].style.top = `${dotTop}px`;
      });
    }

    positionDots();
    window.addEventListener('resize', positionDots);

    // Safari fallback: no support for animation-timeline: scroll()
    const supportsScrollTimeline = CSS.supports('animation-timeline', 'scroll()');
    if (!supportsScrollTimeline) {
      const section = body;
      if (!section) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              section.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      observer.observe(section);
    }
  });
</script>

<style>
  /* ==================== SECTION 1 — HERO (letterbox banner) ==================== */
  .studio-hero {
    position: relative;
    min-height: 45svh;
    overflow: hidden;
    isolation: isolate;
  }

  @media (min-width: 1024px) {
    .studio-hero {
      min-height: 55svh;
    }
  }

  .studio-hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--color-deep-brown);
  }

  .studio-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .studio-hero__gradient {
    position: absolute;
    inset: 0;
    background: rgba(58, 42, 34, 0.32);
  }

  .studio-hero__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: 0 var(--space-lg) var(--space-2xl);
  }

  @media (min-width: 1024px) {
    .studio-hero__content {
      padding: 0 var(--space-2xl) var(--space-3xl);
    }
  }

  .studio-hero__eyebrow {
    color: var(--color-warm-white);
    margin-bottom: var(--space-xs);
    display: inline-block;
  }

  .studio-hero__headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--size-h1);
    line-height: var(--line-tight);
    color: var(--color-warm-white);
    margin-bottom: var(--space-lg);
    text-wrap: balance;
  }

  .studio-hero__support {
    font-family: var(--font-body);
    font-size: var(--size-body-lg);
    color: var(--color-warm-white);
    max-width: 48ch;
    line-height: 1.5;
    margin-bottom: var(--space-xl);
  }

  @media (max-width: 639px) {
    .studio-hero__cta {
      width: 100%;
      max-width: 360px;
    }
  }

  /* ==================== SECTION 2 — TIMELINE ==================== */
  .timeline {
    background-color: var(--color-warm-white);
    padding: var(--space-4xl) 0;
  }

  @media (min-width: 1024px) {
    .timeline {
      padding: var(--space-5xl) 0;
    }
  }

  .timeline__header {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .timeline__header .eyebrow {
    color: var(--color-terracotta);
    margin-bottom: var(--space-md);
  }

  .timeline__headline {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--size-h2);
    line-height: var(--line-tight);
    color: var(--color-deep-brown);
  }

  .timeline__body {
    position: relative;
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--space-lg);
  }

  @media (min-width: 1024px) {
    .timeline__body {
      padding-inline: var(--space-2xl);
    }
  }

  /* SVG path */
  .timeline__svg {
    display: none;
  }

  @media (min-width: 1024px) {
    .timeline__svg {
      display: block;
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 200px;
      height: 100%;
      pointer-events: none;
      z-index: 0;
    }
  }

  /* Mobile: SVG as a thin left-edge line */
  @media (max-width: 1023px) {
    .timeline__svg {
      display: block;
      position: absolute;
      top: 0;
      left: 20px;
      width: 40px;
      height: 100%;
      pointer-events: none;
      z-index: 0;
    }
  }

  /* Scroll-draw animation (Chrome, Firefox) */
  .timeline__path {
    stroke-dasharray: var(--path-length);
    stroke-dashoffset: var(--path-length);
    animation: draw-path linear forwards;
    animation-timeline: scroll(nearest block);
    animation-range: entry 20% exit 80%;
  }

  @keyframes draw-path {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Safari fallback: animate on visibility */
  @supports not (animation-timeline: scroll()) {
    .timeline__path {
      animation: none;
      transition: stroke-dashoffset 2.5s ease-out;
    }

    .is-visible .timeline__path {
      stroke-dashoffset: 0;
    }
  }

  /* Reduced motion: show full path immediately */
  @media (prefers-reduced-motion: reduce) {
    .timeline__path {
      animation: none;
      stroke-dashoffset: 0;
      transition: none;
    }
  }

  /* Milestones */
  .timeline__milestones {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4xl);
  }

  .timeline__milestone {
    position: relative;
  }

  /* Milestone dot nodes — positioned by JS to align with actual milestones */
  .timeline__dot {
    position: absolute;
    pointer-events: none;
    z-index: 1;
  }

  .timeline__dot-outer {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-terracotta);
    opacity: 0.5;
    position: absolute;
    top: 0;
    left: 0;
  }

  .timeline__dot-inner {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-terracotta);
    position: absolute;
    top: 4px;
    left: 4px;
  }

  .timeline__year {
    color: var(--color-terracotta);
    display: block;
    margin-bottom: var(--space-sm);
  }

  .timeline__milestone-title {
    font-family: var(--font-display);
    font-size: var(--size-h3);
    font-weight: 500;
    color: var(--color-deep-brown);
    line-height: var(--line-snug);
    margin-bottom: var(--space-md);
  }

  .timeline__milestone-body {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--size-body);
    line-height: var(--line-body);
    color: var(--color-espresso);
    max-width: 48ch;
  }

  /* Mobile: left-aligned with padding for SVG line */
  @media (max-width: 1023px) {
    .timeline__milestone {
      padding-left: 56px;
    }
  }

  /* Desktop: 12-col grid, alternating left/right */
  @media (min-width: 1024px) {
    .timeline__milestones {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: var(--space-4xl) 0;
    }

    .timeline__milestone--left {
      grid-column: 1 / 6;
      text-align: left;
    }

    .timeline__milestone:nth-child(1) { grid-row: 1; }
    .timeline__milestone:nth-child(2) { grid-row: 2; }
    .timeline__milestone:nth-child(3) { grid-row: 3; }

    .timeline__milestone--right {
      grid-column: 7 / 12;
      text-align: left;
    }
  }

  /* Pull quote */
  .timeline__quote {
    font-family: var(--font-display);
    font-size: var(--size-h3);
    font-weight: 400;
    font-style: italic;
    line-height: var(--line-snug);
    color: var(--color-terracotta);
    text-align: center;
    max-width: 32ch;
    margin: var(--space-4xl) auto 0;
    padding-inline: var(--space-lg);
  }

  /* ==================== SECTION 3 — INSTAGRAM GRID ==================== */
  .insta {
    background-color: var(--color-cream);
    padding: var(--space-4xl) 0;
  }

  @media (min-width: 1024px) {
    .insta {
      padding: var(--space-5xl) 0;
    }
  }

  .insta__header {
    margin-bottom: var(--space-2xl);
  }

  .insta__header .eyebrow {
    color: var(--color-terracotta);
    margin-bottom: var(--space-md);
  }

  .insta__headline {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--size-h2);
    line-height: var(--line-tight);
    color: var(--color-deep-brown);
