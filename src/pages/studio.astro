---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="The Studio — Prana Wellness Club"
  description="Tour the Prana Wellness Club studio in East Austin. Page coming soon."
>
  <section class="stub">
    <div class="container">
      <span class="eyebrow">The Studio</span>
      <h1>Coming soon</h1>
    </div>
  </section>
</BaseLayout>

<style>
  .stub {
    padding: var(--space-5xl) 0;
    min-height: 60svh;
    display: flex;
    align-items: center;
  }
  .stub .eyebrow {
    display: block;
    color: var(--color-terracotta);
    margin-bottom: var(--space-md);
  }
</style>
